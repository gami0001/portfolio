---
import { Image } from "astro:assets";
import IndexMe from "../assets/images/index_img.png";
---

<section class="hero">
  <div class="hero_content">
    <div class="name_block">
      <h3>PORTFOLIO</h3>
      <!-- <h2><span class="light">Gabrielle</span> Cernias Mikkelsen</h2> -->
      <p class="subtitle">Gabrielle Cernias Mikkelsen</p>
    </div>
    <h3 class="top_right">Front-ender</h3>
    <Image src={IndexMe} alt="Picture of me" />
  </div>
</section>
<style>
  @layer components {
    .hero {
      grid-column: full;

      overflow: hidden;
    }

    .hero_content {
      display: grid;
      grid-template-areas: "stack";
      grid-area: 1 / 1;
      width: 100%;
    }

    .hero_content .top_right {
      font-family: "Figtree", sans-serif;
      grid-area: 1 / 1;
      z-index: 1;
      place-self: start end;

      font-size: clamp(1.5rem, 5vw, 3.6rem);
      margin: clamp(1rem, 3vw, 3rem);
    }

    .hero_content img {
      grid-area: 1 / 1;
      width: 100%;
      height: auto;
      object-fit: cover;
      display: block;
    }

    .name_block {
      grid-area: 1 / 1;
      z-index: 1;
      place-self: start start;
      text-align: left;
      margin: clamp(1rem, 3vw, 3rem);
    }

    .name_block h3 {
      margin: 0;
      font-size: clamp(1.5rem, 4vw, 6rem);
      text-box-trim: trim-both;

      text-box-edge: cap alphabetic;
    }

    .hero_content .subtitle {
      grid-area: 1 / 1;
      z-index: 1;
      place-self: start end;
    }

    .name_block .subtitle {
      margin-top: 0.2em;
      font-size: clamp(1rem, 2vw, 1.6rem);
      color: black;
      font-family: "Figtree", sans-serif;
    }
  }
</style>
